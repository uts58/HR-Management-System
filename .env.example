# ---- Docker Compose ----
DB_NAME=hrdb
DB_USER=hruser
DB_PASS=changeme

# ---- Local development ----
DATABASE_URL=postgresql://hruser:changeme@localhost:5432/hrdb

# ---- Optional ----
# PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

# ---- New web app (docker compose --profile web) ----
# Least-privilege role that owns only the hr_web database (db-init creates it).
# URL-safe values only, e.g. `openssl rand -hex 24`.
WEB_DB_USER=hr_web_app
WEB_DB_PASS=change-me-web-db-password
WEB_DB_NAME=hr_web
# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-plus-character-random-secret
BETTER_AUTH_URL=http://localhost:3001
# REQUIRED. MUST BE SET PER DEPLOYMENT to the organisation's IANA time zone
# (no default in code). Placeholder:
APP_TIME_ZONE=Asia/Dhaka