# ---- Docker Compose ----
DB_NAME=hrdb
DB_USER=hruser
DB_PASS=changeme

# ---- Local development ----
DATABASE_URL=postgresql://hruser:changeme@localhost:5432/hrdb

# ---- Sessions / security ----
# Required when NODE_ENV=production (the app refuses to start without it).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string
# Secure flag on the session cookie: auto (default; Secure when the request is HTTPS), true, false.
# COOKIE_SECURE=auto
# Express "trust proxy" setting. Set it when running behind a TLS-terminating reverse proxy or
# load balancer (e.g. 1 for one hop) so HTTPS detection and rate limiting see the real client.
# TRUST_PROXY=
# Postgres schema that holds the session table (created automatically at startup).
# SESSION_SCHEMA=legacy_session
# Session lifetime in hours.
# SESSION_MAX_AGE_HOURS=8
# Login attempts allowed per 15 minutes, per IP and per username.
# LOGIN_RATE_LIMIT_IP=20
# LOGIN_RATE_LIMIT_USER=10
# bcrypt cost factor.
# BCRYPT_ROUNDS=12

# ---- Optional ----
# PORT=3000
