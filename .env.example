# ---- Docker Compose ----
DB_NAME=hrdb
DB_USER=hruser
DB_PASS=changeme

# ---- Local development ----
DATABASE_URL=postgresql://hruser:changeme@localhost:5432/hrdb

# ---- Sessions / security ----
# Required when NODE_ENV=production (the app refuses to start without it).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string
# Secure flag on the session cookie: auto (default; Secure when the request is HTTPS), true, false.
# COOKIE_SECURE=auto
# Number of reverse-proxy hops in front of the app. PRODUCTION BEHIND A REVERSE PROXY / LOAD
# BALANCER MUST SET THE EXACT HOP COUNT (usually 1). NEVER set it to "true": that trusts any
# client-supplied X-Forwarded-For, so clients can fake their IP and bypass the login rate limit
# (the app refuses to start with "true"). Leave unset only when clients connect directly.
# TRUST_PROXY=1
# Postgres schema that holds the session table. Create it before deploying:
#   npm run db:session-table   (or psql -f prisma/legacy-session-table.sql)
# SESSION_SCHEMA=legacy_session
# Let the app create the session schema/table itself at startup (needs CREATE privilege).
# SESSION_TABLE_AUTO_CREATE=false
# Separate connection string for the session store (node-postgres). Defaults to DATABASE_URL.
# Needed only if pg and Prisma must read sslmode differently; see README "Database TLS".
# SESSION_DATABASE_URL=
# Session idle lifetime in hours (rolling).
# SESSION_MAX_AGE_HOURS=8
# Login attempts allowed per 15 minutes: per IP, and per username from the same IP.
# LOGIN_RATE_LIMIT_IP=20
# LOGIN_RATE_LIMIT_USER=10
# bcrypt cost factor.
# BCRYPT_ROUNDS=12

# ---- Optional ----
# PORT=3000

# ---- New web app (docker compose --profile web) ----
# Least-privilege role that owns only the hr_web database (db-init creates it).
# URL-safe values only, e.g. `openssl rand -hex 24`.
WEB_DB_USER=hr_web_app
WEB_DB_PASS=change-me-web-db-password
WEB_DB_NAME=hr_web
# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-plus-character-random-secret
BETTER_AUTH_URL=http://localhost:3001
# Containers run with TZ=UTC (fixed in docker-compose.yml), so there is
# nothing to set here.
