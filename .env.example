# ---- Docker Compose (docker-compose.yml) ----
# Postgres superuser, used only by the db-init job.
DB_USER=hruser
DB_PASS=changeme

# Least-privilege role that owns only the hr_web database (db-init creates it).
# URL-safe values only, e.g. `openssl rand -hex 24`.
WEB_DB_USER=hr_web_app
WEB_DB_PASS=change-me-web-db-password
WEB_DB_NAME=hr_web
# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-plus-character-random-secret
BETTER_AUTH_URL=http://localhost:3001
# Containers run with TZ=UTC (fixed in docker-compose.yml), so there is
# nothing to set here.
