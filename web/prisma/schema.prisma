// HR Management System - schema v2 (Phase 0 draft)
// Owner: Data lead. The rationale and the legacy -> v2 column mapping are in
// docs/data/schema-decisions.md. Keep the two in sync.
//
// Prisma 7: the connection URL is NOT in this file. It is in web/prisma7.config.ts
// (datasource.url, owned by Platform). The client is generated by the Rust-free
// `prisma-client` generator and needs a driver adapter at runtime
// (@prisma/adapter-pg).
//
// Conventions: models/fields camelCase, tables/columns snake_case (@map/@@map).
// Calendar dates use @db.Date. Instants use @db.Timestamptz(3) and are stored in UTC.
// Some constraints cannot be written in Prisma schema. They are hand-written SQL in
// migrations/*_init/migration.sql:
//   - unique lower(name) on departments / positions (case-insensitive uniqueness)
//   - CHECK end >= start on leave_requests / appraisals, CHECK rating 1..5
//   - CHECK username = lower(username) on users

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums (legacy magic-int mapping is in the comment on each enum)
// ---------------------------------------------------------------------------

/// legacy person.access: 0 -> EMPLOYEE, 1 -> HR_ADMIN
enum Role {
  EMPLOYEE
  HR_ADMIN

  @@map("role")
}

/// legacy employee.gender: 1 -> MALE, 0 -> FEMALE
enum Gender {
  MALE
  FEMALE

  @@map("gender")
}

/// legacy employee.maritalStatus: 'single' | 'married' | 'divorced'; '0' / '' -> NULL
enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED

  @@map("marital_status")
}

/// No legacy column. Legacy hard-deleted employees; v2 soft-deletes them.
enum EmploymentStatus {
  ACTIVE
  TERMINATED

  @@map("employment_status")
}

/// legacy empleave.status: 0 -> PENDING, 1 -> APPROVED, 2 -> REJECTED
enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("leave_status")
}

/// legacy empleave.leaveType (fixed <select> in views/addLeave.ejs):
/// "Sick Leave" -> SICK, "Annual Leave" -> ANNUAL, "Casual Leave" -> CASUAL,
/// "Maternity Leave" -> MATERNITY, "Unpaid Leave" -> UNPAID. Matching ignores case and whitespace.
/// OTHER is reserved for migrated values that match none of these (the original text is in
/// legacyLeaveType). The UI never offers OTHER for new requests.
enum LeaveType {
  SICK
  ANNUAL
  CASUAL
  MATERNITY
  UNPAID
  OTHER

  @@map("leave_type")
}

/// legacy notice.type: 0 -> GENERAL, 1 -> URGENT, 2 -> HOLIDAY
enum NoticeType {
  GENERAL
  URGENT
  HOLIDAY

  @@map("notice_type")
}

// ---------------------------------------------------------------------------
// Organisation
// ---------------------------------------------------------------------------

/// Name is unique case-insensitively (SQL index on lower(name)). Deleting a
/// department that employees use is blocked (Restrict).
model Department {
  id        Int        @id @default(autoincrement())
  name      String
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  employees Employee[]

  @@map("departments")
}

model Position {
  id        Int        @id @default(autoincrement())
  name      String
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  employees Employee[]

  @@map("positions")
}

/// Legacy employee ids are preserved. The migration moves the sequence past MAX(id),
/// so the database assigns new ids.
/// Soft delete: set employmentStatus = TERMINATED and terminatedAt. Rows are never
/// hard-deleted while history references them (Restrict on every child FK).
model Employee {
  id            Int            @id @default(autoincrement())
  firstName     String         @map("first_name")
  middleName    String?        @map("middle_name")
  lastName      String         @map("last_name")
  /// Stored lower-case. NOT unique (contract). Many legacy employees share or lack one.
  email         String?
  contactNo     String?        @map("contact_no")
  country       String?
  homeTown      String?        @map("home_town")
  gender        Gender?
  maritalStatus MaritalStatus? @map("marital_status")
  dateOfBirth   DateTime?      @map("date_of_birth") @db.Date

  departmentId Int?        @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  positionId   Int?        @map("position_id")
  position     Position?   @relation(fields: [positionId], references: [id], onDelete: Restrict)

  employmentStatus EmploymentStatus @default(ACTIVE) @map("employment_status")
  terminatedAt     DateTime?        @map("terminated_at") @db.Timestamptz(3)

  /// true only for rows the migration created to hold orphaned legacy history (leave or
  /// appraisals whose employee legacy hard-deleted). They are always TERMINATED, have no
  /// login, and are named "Unknown employee #<id>". Services must exclude them from
  /// employee lists, pickers and counts (WHERE is_placeholder = false).
  isPlaceholder Boolean @default(false) @map("is_placeholder")

  /// NULL for migrated rows (legacy kept no timestamps). Always set for new rows.
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User?
  leaveRequests LeaveRequest[]
  appraisals    Appraisal[]

  @@index([departmentId])
  @@index([positionId])
  @@index([employmentStatus, isPlaceholder])
  @@index([email])
  @@index([lastName, firstName])
  @@map("employees")
}

// ---------------------------------------------------------------------------
// Leave
// ---------------------------------------------------------------------------

model LeaveRequest {
  id         Int      @id @default(autoincrement())
  employeeId Int      @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  leaveType       LeaveType @map("leave_type")
  /// The original legacy text, kept only when the migration mapped it to OTHER (so nothing is lost).
  /// NULL for every other row.
  legacyLeaveType String?   @map("legacy_leave_type")
  /// NULL only for migrated rows whose legacy text could not be parsed (ADR-0007).
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  reason    String?

  status         LeaveStatus @default(PENDING)
  /// Legacy `read`, inverted for clarity. false = HR has decided and the employee has not looked yet.
  seenByEmployee Boolean     @default(true) @map("seen_by_employee")
  decidedAt      DateTime?   @map("decided_at") @db.Timestamptz(3)
  decidedById    String?     @map("decided_by_id")
  decidedBy      User?       @relation("LeaveDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  /// NULL for migrated rows.
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([employeeId, status])
  @@index([status, id])
  @@map("leave_requests")
}

// ---------------------------------------------------------------------------
// Notices
// ---------------------------------------------------------------------------

model Notice {
  id    Int        @id @default(autoincrement())
  title String
  body  String
  type  NoticeType @default(GENERAL)

  /// The publish time. Migrated rows get it from the legacy `date` text
  /// (midnight UTC), or NULL when that text is unparseable.
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([createdAt(sort: Desc)])
  @@map("notices")
}

// ---------------------------------------------------------------------------
// Performance appraisal
// ---------------------------------------------------------------------------

model Appraisal {
  id           Int       @id @default(autoincrement())
  employeeId   Int       @map("employee_id")
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  projectName  String?   @map("project_name")
  projectStart DateTime? @map("project_start") @db.Date
  projectEnd   DateTime? @map("project_end") @db.Date
  /// 1 Poor .. 5 Excellent (CHECK constraint in SQL)
  rating       Int?      @db.SmallInt

  /// NULL for migrated rows.
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([employeeId])
  @@map("appraisals")
}

// ===========================================================================
// AUTH: Better Auth core schema (user / session / account / verification)
// ---------------------------------------------------------------------------
// SECURITY reviews and owns the final shape. The field names follow the Better Auth
// core schema and the `username` plugin, so the Prisma adapter works with no
// `fields` remapping. Only table and column names are remapped to snake_case.
// HR-specific fields on User (role, mustChangePassword, employeeId, legacyPersonId)
// must be declared as `user.additionalFields` in the Better Auth config.
//
// The credential password is NOT on User. Better Auth keeps it in
// account.password for the row with providerId = 'credential' and accountId = user.id.
// Stored format after migration (director decision): EVERY migrated password is bcrypt
// ("$2a$"/"$2b$", cost 12 for newly hashed plaintext). The legacy app's bcrypt hashes are copied
// unchanged and leftover plaintext is bcrypt-hashed. Security's emailAndPassword.password.verify
// must accept bcrypt and rehash to argon2id on successful login. New passwords set in v2 are
// argon2id (@node-rs/argon2, "$argon2id$..."). See docs/data/schema-decisions.md.
// ===========================================================================

model User {
  id            String  @id
  /// Better Auth requires this. Display name ("First Last").
  name          String
  /// Better Auth requires this and keeps it unique. It is the employee's email only when that
  /// is unique. Otherwise it is a synthetic "<username>@users.invalid" (employee emails are not unique).
  email         String  @unique
  /// true when `email` is the placeholder "<username>@users.invalid" (no usable legacy email).
  /// The app shows "no email on file" and never sends mail to it. A CHECK keeps it consistent with the domain.
  emailIsPlaceholder Boolean @default(false) @map("email_is_placeholder")
  emailVerified Boolean @default(false) @map("email_verified")
  image         String?

  /// username plugin: normalised lower-case login name (CHECK constraint in SQL).
  username        String  @unique
  displayUsername String? @map("display_username")

  // ---- HR additional fields ----
  role               Role      @default(EMPLOYEE)
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  /// 1:1 with Employee. Nullable for accounts that have no employee record.
  employeeId         Int?      @unique @map("employee_id")
  employee           Employee? @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  /// legacy person.id. Used for idempotent re-runs of the migration. NULL for new users.
  legacyPersonId     String?   @unique @map("legacy_person_id")
  /// Login is blocked while this is set (director ruling). terminateEmployee sets it.
  /// It also works for users with no employee record. Our own `role` column is the
  /// source of truth: Better Auth's admin-plugin role/banned fields are NOT used.
  disabledAt         DateTime? @map("disabled_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions       Session[]
  accounts       Account[]
  leaveDecisions LeaveRequest[] @relation("LeaveDecider")

  @@index([role])
  @@map("users")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  /// For providerId 'credential' this is user.id.
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  /// Password hash for providerId 'credential'.
  password              String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

// ========================== END AUTH SECTION ===============================
