# Copy to .env and fill in. Variables are validated at startup by src/env.ts.
# `.env` is read by Next.js and by the Prisma CLI (via prisma7.config.ts).

# --- Database -----------------------------------------------------------
# The NEW app's own database (hr_web), separate from the legacy `hrdb`.
# Matches compose.dev.yml defaults (Postgres on localhost:5432).
DATABASE_URL=postgresql://hruser:changeme@localhost:5432/hr_web

# --- Auth (Better Auth) -------------------------------------------------
# At least 32 chars, high entropy. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-plus-character-random-secret
# Public base URL of the app (scheme + host + port, no trailing slash).
BETTER_AUTH_URL=http://localhost:3000

# --- App ----------------------------------------------------------------
# Organisation time zone (IANA). Drives day boundaries for attendance/leave.
APP_TIME_ZONE=Asia/Dhaka
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Tooling ------------------------------------------------------------
# Set to 1 to skip env validation (only for builds/lint without secrets).
# SKIP_ENV_VALIDATION=1
