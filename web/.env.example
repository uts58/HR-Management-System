# Copy to .env and fill in. Variables are validated at startup by src/env.ts.
# `.env` is read by Next.js and by the Prisma CLI (via prisma7.config.ts).

# --- Database -----------------------------------------------------------
# The NEW app's own database (hr_web) and least-privilege role (hr_web_app),
# separate from the legacy `hrdb`/superuser. Matches compose.dev.yml
# (Postgres on 127.0.0.1:5432).
DATABASE_URL=postgresql://hr_web_app:changeme_web@localhost:5432/hr_web

# --- Auth (Better Auth) -------------------------------------------------
# At least 32 chars, high entropy. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-plus-character-random-secret
# Public base URL of the app (scheme + host + port, no trailing slash).
BETTER_AUTH_URL=http://localhost:3000

# --- App ----------------------------------------------------------------
# The server runs in UTC, as in Docker and CI, so server-side date handling
# is deterministic. There is no company time zone: timestamps are stored in
# UTC and rendered in each viewer's browser zone.
TZ=UTC
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Tooling ------------------------------------------------------------
# Only honoured during `next build` (and Vitest). At runtime it is ignored
# with a warning, and validation always runs.
# SKIP_ENV_VALIDATION=1
