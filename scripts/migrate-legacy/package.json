{
  "name": "hr-migrate-legacy",
  "version": "0.1.0",
  "private": true,
  "description": "One-off migration: legacy HR Postgres DB -> schema v2 (web/prisma/schema.prisma)",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "migrate": "tsx src/index.ts",
    "migrate:dry": "tsx src/index.ts --dry-run",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
