# Production reverse proxy (used by compose.prod.yml).
#
# Forwarded headers: no `trusted_proxies` is configured, so Caddy DISCARDS
# any client-supplied X-Forwarded-For / X-Forwarded-Proto / X-Forwarded-Host
# and sets them itself. X-Forwarded-For becomes exactly one entry: the
# client's TCP peer address. The apps therefore trust exactly one hop
# (legacy: TRUST_PROXY=1). Do not add `trusted_proxies` unless another proxy
# or CDN sits in front of Caddy, and if you do, raise the hop count to match.
#
# UPSTREAM selects the active app: app:3000 (legacy, default) before
# cutover, web:3000 after. Changing it is the cutover switch (runbook step 7).

{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# No active health check here: the legacy app has no /api/health. Add
	# `health_uri /api/health` once UPSTREAM is web:3000.
	reverse_proxy {$UPSTREAM:app:3000}
}
