# Production reverse proxy (used by compose.prod.yml).
#
# Forwarded headers: no `trusted_proxies` is configured, so Caddy DISCARDS
# any client-supplied X-Forwarded-For / X-Forwarded-Proto / X-Forwarded-Host
# and sets them itself. X-Forwarded-For becomes exactly one entry: the
# client's TCP peer address. Do not add `trusted_proxies` unless another
# proxy or CDN sits in front of Caddy.

{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy web:3000 {
		health_uri /api/health
	}
}
